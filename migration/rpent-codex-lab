"""Start Codex for RPent using the local lab Responses provider.

Select with CODEX_BIN=/data/gc02/RPent/migration/rpent-codex-lab.
Credentials stay in process memory and the child environment, never CLI arguments.
"""

import asyncio
import json
import os
import signal
import subprocess
import sys
import tomllib
from pathlib import Path

from rpent_codex_tool_filter import (
    load_tools,
    mcp_url_from_args,
    root_config_overrides,
    tool_filter,
)


def main():
    config_root = Path(
        os.environ.get("RPENT_RELAY_CONFIG_DIR", str(Path.home() / ".codex"))
    )
    config = tomllib.loads((config_root / "lab-relay.config.toml").read_text())
    provider = config["model_provider"]
    settings = config["model_providers"][provider]
    if settings["wire_api"] != "responses":
        raise ValueError("Lab provider must use Responses")
    binary = os.environ["RPENT_CODEX_EXECUTABLE"]
    overrides = {
        "model": config["model"],
        "model_provider": provider,
    }
    for field in ("name", "base_url", "wire_api", "env_key", "requires_openai_auth"):
        if field in settings:
            overrides[f"model_providers.{provider}.{field}"] = settings[field]
    args = [binary]
    for key, value in overrides.items():
        args.extend(["-c", f"{key}={json.dumps(value)}"])
    args.extend(sys.argv[1:])
    secret = (config_root / "lab-relay.key").read_text().strip()
    if not secret:
        raise ValueError("Lab credential is empty")
    env = dict(os.environ)
    env[settings["env_key"]] = secret
    url = mcp_url_from_args(sys.argv[1:])
    tools = asyncio.run(asyncio.wait_for(load_tools(url), timeout=30)) if url else []
    # Disable unrelated sources locally and restrict the model-visible catalog.
    settings_overrides = {
        "features.apps": False,
        "features.plugins": False,
        "features.shell_tool": False,
        "features.goals": False,
        "features.multi_agent": False,
        "features.image_generation": False,
        "tools.view_image": False,
        "features.skill_search": False,
        "features.tool_suggest": False,
        "features.enable_request_compression": False,
        "web_search": "disabled",
    }
    with tool_filter(settings["base_url"], tools, secret) as local_url:
        settings_overrides["model_provider"] = provider
        settings_overrides[f"model_providers.{provider}.name"] = settings.get(
            "name", provider
        )
        settings_overrides[f"model_providers.{provider}.base_url"] = local_url
        # Keep overrides at the CLI root. App-server-local overrides otherwise
        # replace the SDK's root overrides, including the RPent MCP URL.
        args = root_config_overrides(args, settings_overrides)
        child = subprocess.Popen(args, env=env)
        old_handlers = {}
        try:
            for sig in (signal.SIGINT, signal.SIGTERM):
                old_handlers[sig] = signal.signal(
                    sig, lambda signum, frame: child.send_signal(signum)
                )
            code = child.wait()
        finally:
            if child.poll() is None:
                child.terminate()
                child.wait(timeout=10)
            for sig, handler in old_handlers.items():
                signal.signal(sig, handler)
    sys.exit(code)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError):
        sys.exit("RPent lab adapter could not load or launch the local configuration")
